# URL de la API que usa el navegador (se incorpora al compilar; sin secretos).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
# URL de la API desde el servidor de Next, dentro de la red de Docker.
API_INTERNAL_URL=http://api:8000/v1
# Origen de las imágenes (URL prefirmadas del almacenamiento), permitido en la CSP (img-src).
STORAGE_PUBLIC_URL=http://localhost:9000
