# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- PostgreSQL ---
POSTGRES_USER=entrevecinos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=entrevecinos
POSTGRES_HOST_PORT=5432   # solo para docker-compose.db-debug.yml

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Clave de firma de los JWT (mínimo 32 caracteres). Genera una propia: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_TTL_SECONDS=86400

# --- Almacenamiento (MinIO) ---
# Administración de MinIO (solo storage-init). Contraseña de al menos 8 caracteres.
MINIO_ROOT_USER=entrevecinos-root
MINIO_ROOT_PASSWORD=change-me-root-password
# Bucket privado de las imágenes y credenciales propias de la API (distintas de las de root).
STORAGE_BUCKET=entrevecinos-media
STORAGE_ACCESS_KEY=entrevecinos-api
STORAGE_SECRET_KEY=change-me-api-secret
STORAGE_HOST_PORT=9000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# --- Correo (SMTP) ---
# En desarrollo, Mailpit (servicio `mail`) recoge los correos: http://localhost:8025
# En producción, apunta a tu proveedor SMTP con SMTP_STARTTLS=true y WEB_PUBLIC_URL en https.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="EntreVecinos <no-reply@entrevecinos.local>"
# Origen de los enlaces que se envían por correo (validación de la cuenta).
WEB_PUBLIC_URL=http://localhost:3000
# Caducidad del enlace de validación del correo, en horas.
EMAIL_VERIFICATION_TTL_HOURS=24
MAIL_UI_HOST_PORT=8025
