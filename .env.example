# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- PostgreSQL ---
POSTGRES_USER=entrevecinos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=entrevecinos
POSTGRES_HOST_PORT=5432   # solo para docker-compose.db-debug.yml

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Clave de firma de los JWT (mínimo 32 caracteres). Genera una propia: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_TTL_SECONDS=86400

# --- Almacenamiento (MinIO) ---
# Administración de MinIO (solo storage-init). Contraseña de al menos 8 caracteres.
MINIO_ROOT_USER=entrevecinos-root
MINIO_ROOT_PASSWORD=change-me-root-password
# Bucket privado de las imágenes y credenciales propias de la API (distintas de las de root).
STORAGE_BUCKET=entrevecinos-media
STORAGE_ACCESS_KEY=entrevecinos-api
STORAGE_SECRET_KEY=change-me-api-secret
STORAGE_HOST_PORT=9000
# En AWS (TK-081): sin endpoints ni claves (credenciales del rol de la instancia),
# STORAGE_REGION=eu-north-1 y STORAGE_ADDRESSING_STYLE=virtual. En local, MinIO usa los valores por defecto.
# STORAGE_REGION=us-east-1
# STORAGE_ADDRESSING_STYLE=path

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# --- Correo (SMTP) ---
# En desarrollo, Mailpit (servicio `mail`) recoge los correos: http://localhost:8025
# En producción (AWS) se envía por SMTP con Brevo (TK-098): MAIL_BACKEND=smtp,
# SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587 y SMTP_STARTTLS=true, con WEB_PUBLIC_URL en https.
# El usuario y la clave SMTP están en Parameter Store y solo llegan por entorno al desplegar
# (ver infra/docker-compose.prod.yml). SES queda como vuelta atrás: MAIL_BACKEND=ses, sin clave SMTP.
MAIL_BACKEND=smtp
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="EntreVecinos <no-reply@entrevecinos.local>"
# Origen de los enlaces que se envían por correo (validación de la cuenta).
WEB_PUBLIC_URL=http://localhost:3000
# Caducidad del enlace de validación del correo, en horas.
EMAIL_VERIFICATION_TTL_HOURS=24
# Caducidad del enlace para restablecer la contraseña, en minutos (TK-101).
PASSWORD_RESET_TTL_MINUTES=60
# Cupo de correos por periodo, del día EMAIL_QUOTA_RESET_DAY de un mes al del siguiente (TK-099).
# Restricción de costes: en producción, 5000 (plan más barato de Brevo). Al llegar, la API
# responde 503 al registro, al reenvío y al restablecimiento de la contraseña.
EMAIL_MONTHLY_LIMIT=5000
EMAIL_QUOTA_RESET_DAY=6
MAIL_UI_HOST_PORT=8025

# --- Producción (AWS) ---
# Referencia: en producción NO hay .env. deploy.sh exporta los secretos desde Parameter Store y
# el resto está fijo en infra/docker-compose.prod.yml (ver infra/aws/README.md, «Secretos»).
# Valores ficticios; los reales nunca se escriben en ficheros.
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://entrevecinos_app:<de /entrevecinos/prod/db/app-password>@db:5432/entrevecinos
# JWT_SECRET=<de /entrevecinos/prod/jwt-secret>
# CORS_ORIGINS=https://entrevecinos.org
# STORAGE_BUCKET=entrevecinos-media-<cuenta>
# STORAGE_REGION=eu-north-1
# STORAGE_ADDRESSING_STYLE=virtual
# MAIL_BACKEND=ses
# SES_REGION=eu-north-1
# SES_CONFIGURATION_SET=entrevecinos-prod
# MAIL_FROM="EntreVecinos <no-reply@entrevecinos.org>"
# WEB_PUBLIC_URL=https://entrevecinos.org
# API_INTERNAL_URL=http://api:8000/v1   # web
# STORAGE_PUBLIC_URL=https://entrevecinos-media-<cuenta>.s3.eu-north-1.amazonaws.com   # web
